# 复制为 .env 后填值。三台机器除 NODE_NAME 外必须完全一致。

# ---------- 镜像 ----------
# 用仓库里的脚本从源码构建并推送到自己的 ACR（国内 ECS 直接拉 Docker Hub 不稳定）：
#   echo v1.0.0-rc.35-custom.1 > VERSION
#   deploy/build-server-image.sh          # 产出 new-api-server:v1.0.0-rc.35-custom.1
#   deploy/build-web-image.sh             # 产出 new-api-web:v1.0.0-rc.35-custom.1
#   ACR=registry.cn-hangzhou.aliyuncs.com/<命名空间>
#   for i in new-api-server new-api-web; do docker tag $i:v1.0.0-rc.35-custom.1 $ACR/$i:v1.0.0-rc.35-custom.1 && docker push $ACR/$i:v1.0.0-rc.35-custom.1; done
# 固定版本号，不要用 latest。前后端镜像用同一个 tag 一起升级。
SERVER_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/new-api-server:v1.0.0-rc.35-custom.1
WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<命名空间>/new-api-web:v1.0.0-rc.35-custom.1

# 本节点名，写进审计日志。三台分别为 node-1 / node-2 / node-3
NODE_NAME=node-1

# ---------- 密钥（全节点相同，上线后不可更改）----------
# 生成：openssl rand -base64 48
SESSION_SECRET=
# 可不填，默认等于 SESSION_SECRET；填了也必须全节点相同
CRYPTO_SECRET=

# ---------- 数据库 ----------
# RDS PostgreSQL 内网地址，先在 RDS 控制台建好数据库 new_api 和账号
SQL_DSN=postgresql://newapi:<密码>@<rds内网地址>:5432/new_api
# 每节点连接数上限。三节点合计不能超过 RDS 的 max_connections
SQL_MAX_OPEN_CONNS=200
SQL_MAX_IDLE_CONNS=50
# 可选：日志分库。留空则写主库 logs 表
# LOG_SQL_DSN=postgresql://newapi:<密码>@<rds内网地址>:5432/new_api_log

# ---------- Redis ----------
# 云 Redis 内网地址。三台必须连同一个实例，限流和缓存才是全局的
REDIS_CONN_STRING=redis://:<密码>@<redis内网地址>:6379/0

# ---------- 运行 ----------
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
# 请求正文日志目录（容器内路径，compose 已挂卷到宿主机 ./requests）；设为 off 关闭
REQUEST_LOG_DIR=/data/requests
REQUEST_LOG_MAX_SIZE_MB=256
REQUEST_LOG_RETENTION_DAYS=30
# 内存队列中正文字节上限（MB），超出则整条丢弃并计数；留空或 0 使用默认值
REQUEST_LOG_QUEUE_BYTES_MB=256
# 额度扣减批量写库，每 5 秒一批。节点崩溃会丢这几秒的扣费记录；流量大再开
BATCH_UPDATE_ENABLED=false
# 内存缓存与库同步周期，秒
SYNC_FREQUENCY=60
# 流式响应空闲超时，秒。推理模型思考阶段可能长时间不吐字，按实测调；
# ALB 的空闲超时必须大于等于此值
STREAMING_TIMEOUT=600
# 优雅退出等待时间，秒。compose 里的 stop_grace_period 要大于它
SHUTDOWN_TIMEOUT_SECONDS=120
# 请求体上限 MB，解压后计算
MAX_REQUEST_BODY_MB=128

# ---------- 网络 ----------
# 信任的反向代理地址段：同机的 nginx 容器（docker 网段 172.16.0.0/12）加 ALB 所在的 VPC 网段，
# 逗号分隔。这样 X-Forwarded-For 才被采信，限流和日志里才是真实客户端 IP
TRUSTED_PROXIES=172.16.0.0/12,<VPC网段，如 10.0.0.0/8>
# 通过 HTTPS 访问时开启，并列出控制台的精确 HTTPS Origin（逗号分隔，不带路径）
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://<你的域名>
